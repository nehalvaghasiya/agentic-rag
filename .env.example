# Runtime settings: MODE must be exactly production or deterministic.
MODE=production

# Integer limits; there are no hard maximums.
# CHUNK_SIZE >= 1 and 0 <= CHUNK_OVERLAP < CHUNK_SIZE.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# TOP_K >= 1 and MAX_RETRIES >= 0 (zero permits no retries).
TOP_K=5
MAX_RETRIES=2

# Compatible minimum chunk settings: CHUNK_SIZE=1 and CHUNK_OVERLAP=0.
# Provider credentials are optional at startup, including in production mode.

# Chat through OmniRouter (or another OpenAI-compatible endpoint).
# Replace the placeholder with your router API key; an empty key disables chat.
OPENAI_API_KEY=YOUR_NEW_API_KEY
OPENAI_MODEL=auto
OPENAI_BASE_URL=http://localhost:20128/v1

# Embeddings through an OpenAI-compatible endpoint. Model IDs are sent unchanged.
# Use the /v1 base URL, without /embeddings; the client appends that path.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openrouter/qwen/qwen3-embedding-8b
EMBEDDING_BASE_URL=http://localhost:20128/v1
# Empty or omitted: use OPENAI_API_KEY. Set a separate embedding key if needed.
EMBEDDING_API_KEY=
# Empty or omitted EMBEDDING_BASE_URL uses OPENAI_BASE_URL.
# For local models, install the local-embeddings extra and use:
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# 'auto' preserves model-name routing: text-embedding-* uses OpenAI; others are local.

SERPAPI_API_KEY=...
GOOGLE_CSE_ID=...
