# Offline demo defaults. Copy to .env; never commit real secrets.
AGENTIC_RAG_ENVIRONMENT=demo
AGENTIC_RAG_STORE=postgres
LLM_PROVIDER=fake
LLM_MODEL=auto/best-fast
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=

# For live models, set both providers to openai_compatible and supply credentials.
# These can point to a different gateway/account from the LLM settings.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=http://localhost:20128/v1
EMBEDDING_API_KEY=

# For production, set AGENTIC_RAG_DATABASE_URL, AGENTIC_RAG_JWT_SECRET in secret manager

# npm run dev provisions local PostgreSQL connections automatically.
# For a managed/existing database, configure separate application/admin URLs:
# AGENTIC_RAG_DATABASE_URL=postgresql://rag_app:password@127.0.0.1:5432/rag
# AGENTIC_RAG_DATABASE_ADMIN_URL=postgresql://rag:password@127.0.0.1:5432/rag
# Set POSTGRES_PASSWORD to the existing password when reusing a Compose volume.
# AGENTIC_RAG_STREAMING=false  # only for gateways without chat streaming

# Optional read-only structured data. Bundled demo invoices are used only by fake providers.
# AGENTIC_RAG_SQL_DATASET_PATH=/absolute/path/to/approved-invoices.csv
