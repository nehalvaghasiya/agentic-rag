# Copy to .env and get LLM_API_KEY from https://platform.openai.com/api-keys or your gateway
AGENTIC_RAG_ENVIRONMENT=demo
AGENTIC_RAG_STORE=postgres

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=h
LLM_MODEL=
LLM_API_KEY=

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Optional overrides for npm run dev
# EMBEDDING_BASE_URL=""             # From your embedding provider. Defaults to LLM_BASE_URL.
# EMBEDDING_API_KEY=""              # From your embedding provider. Defaults to LLM_API_KEY.
# AGENTIC_RAG_DATABASE_URL=""      # Restricted app connection URL from your database admin
# AGENTIC_RAG_DATABASE_ADMIN_URL="" # Migration connection URL for the same database
# POSTGRES_PASSWORD=""             # Current password for an existing local Compose volume
# AGENTIC_RAG_JWT_SECRET=""         # For local or production, generate with openssl rand -hex 32
# AGENTIC_RAG_STREAMING=false      # Use when your gateway lacks streaming
# AGENTIC_RAG_SQL_DATASET_PATH=""   # Absolute path to a CSV for the read-only SQL tool
