{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.js",
    "test:e2e:install": "playwright install --only-shell chromium",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "dev:web": "vite",
    "generate:api-types": "node scripts/generate-contracts.mjs ../contracts/openapi.json src/api/generated/chat.d.ts",
    "test:security": "node --test scripts/dependency-security.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "picomatch": "file:vendor/picomatch",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "picomatch": "$picomatch"
  }
}
